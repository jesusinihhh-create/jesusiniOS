#!/bin/sh
# Debian Live Build configuration starter for jesusiniOS.
# Run from this directory: sudo lb config && sudo lb build
set -eu
lb config \
  --distribution bookworm \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --debian-installer live \
  --archive-areas "main contrib non-free-firmware" \
  --bootappend-live "boot=live components username=jesusini hostname=jesusiniOS quiet splash"
